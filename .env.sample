# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudinary Configuration
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Analytics (optional)
NEXT_PUBLIC_GA_TRACKING_ID=your_google_analytics_tracking_id

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.solozo.page

# Contact Form (Optional - if using a service like Formspree, EmailJS, etc.)
# Leave empty to use the built-in form without backend submission
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Strapi API (Only needed for data migration script)
# Remove after migration is complete
STRAPI_API_TOKEN=

# Node Environment
NODE_ENV=development
